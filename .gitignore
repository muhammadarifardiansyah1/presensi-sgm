# Local Migration Blueprint
docs_migrasi/

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Log Files
*.log
*.tmp
*.bak
cookie.txt
error_log

# Local Environment Overrides & Testing Scratches
*.local.php
.env
.env.*
scratch/
!scratch/.gitkeep

# User Uploaded Media (Preserve Directory Structure, Ignore Content)
assets/images/uploads/profil/*
!assets/images/uploads/profil/.gitkeep

assets/images/uploads/presensi/*
!assets/images/uploads/presensi/.gitkeep

assets/images/uploads/dokumen/*
!assets/images/uploads/dokumen/.gitkeep

# System & Agent Generated Cache
.gemini/
.system_generated/
.tempmediaStorage/
